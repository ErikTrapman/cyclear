{% extends 'base.html.twig' %}

{% block content %}
    <div class="big-header hidden-xs hidden-sm">
        <h2>Reset wachtwoord</h2>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">Reset wachtwoord</h3>
                    </div>
                    <div class="panel-body">
                        <form class="form form-horizontal"
                              action="{{ path('app_resetting_send_email') }}"
                              method="POST">
                            <div class="form-group">
                                <label class="col-sm-3 control-label"
                                       for="username">E-mailadres</label>

                                <div class="col-sm-8">
                                    <input class="form-control" type="text" id="username" name="username"
                                           required="required"/>
                                </div>
                            </div>
                            <button class="btn"
                                    type="submit">Reset wachtwoord</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
