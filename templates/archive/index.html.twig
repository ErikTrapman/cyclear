{% extends 'base.html.twig' %}
{% block content %}

    <div class="big-header">
        <h2>Archieven</h2>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <table class="table table-bordered table-striped archive">
                    <tr>
                        <th>Seizoen</th>
                        <th></th>
                        <th>Winnaar</th>
                    </tr>
                    {% for row in rows %}
                        {% set award = row.winner %}
                        <tr>
                            <td>
                                {% if row.seizoen %}
                                    <a class="btn btn-default" href="{{ path('game', {seizoen: row.seizoen.slug}) }}">
                                        {{ row.label }} <span class="glyphicon glyphicon-arrow-right"></span>
                                    </a>
                                {% else %}
                                    {{ row.label }}
                                {% endif %}
                            </td>
                            <td title="{{ award ? award.type.label }}">{{ award ? award.type.icon }}</td>
                            <td>
                                {% if award and award.ploeg %}
                                    <a href="{{ path('ploeg_show', {seizoen: award.ploeg.seizoen.slug, id: award.ploeg.id}) }}">{{ award.team }}</a>
                                {% elseif award %}
                                    {{ award.team }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        </div>
    </div>
{% endblock %}
