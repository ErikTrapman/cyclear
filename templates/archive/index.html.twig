{% extends 'base.html.twig' %}
{% block content %}

    <div class="big-header" style="margin-bottom: 0;">
        <h2>Archieven</h2>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <ul style="margin:20px; display: inline-block">
                    {% for seizoen in seizoenen|reverse %}
                        <li style="margin:12px;">
                            <a class="btn btn-default"
                               href="{{ path('game', {seizoen: seizoen.slug}) }}">{{ seizoen.identifier }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <h3>Erelijst</h3>
                <table class="table table-bordered table-striped">
                    <tr>
                        <th>Seizoen</th>
                        <th></th>
                        <th>Ploeg</th>
                        <th>Speler</th>
                    </tr>
                    {% for award in awards()|reverse %}
                        <tr>
                            <td>{{ award.season }}</td>
                            <td title="{{ award.type.label }}">{{ award.type.icon }}</td>
                            <td>
                                {% if award.ploeg %}<a href="{{ path('ploeg_show', {seizoen: award.ploeg.seizoen.slug, id: award.ploeg.id}) }}">{{ award.team }}</a>{% else %}{{ award.team }}{% endif %}
                            </td>
                            <td>{{ award.user ? award.user.firstName }}</td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        </div>
    </div>
{% endblock %}
