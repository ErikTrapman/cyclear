{% block content %}
    <table class="table table-bordered table-striped">
        <tr>
            <th colspan="3" class="hidden-sm hidden-xs">Ploeg</th>
            <th colspan="2" class="hidden-lg hidden-md">Ploeg</th>
            <th>Punten</th>
            {% if withPeriode is defined and withPeriode %}
                <th>Periode</th>
            {% endif %}
        </tr>
        {% for ploeg in list %}
            <tr{% if isMyTeam(ploeg[0]) %} class="my-team" title="Jouw ploeg"{% endif %}>
                {% set curpos = '%02d'|format(loop.index) %}
                {% set badge %}
                    {%- if loop.index <= 3 %} <i class="fa fa-trophy standings-trophy standings-trophy-{{ loop.index }}" title="{{ loop.index }}e plaats"></i>
                    {%- elseif loop.last %} <svg class="standings-lantern" viewBox="0 0 16 16" role="img"><title>Rode lantaarn</title>
                        <circle cx="8" cy="1.8" r="1.2" fill="none" stroke="currentColor" stroke-width="1"/>
                        <path d="M4 6.5 5.5 3.5h5L12 6.5z" fill="currentColor"/>
                        <rect x="5" y="6.5" width="6" height="5.5" fill="#d9261c"/>
                        <ellipse cx="8" cy="9.2" rx="1.3" ry="1.8" fill="#ffb199"/>
                        <path d="M6.5 6.5v5.5M9.5 6.5v5.5" stroke="currentColor" stroke-width=".6"/>
                        <rect x="4" y="12" width="8" height="2.5" rx=".5" fill="currentColor"/>
                    </svg>
                    {%- endif -%}
                {% endset %}
                {% if shadowlist %}
                    {% set prevpos = shadowlist[ploeg[0].id].position %}
                    {% set posdiff = prevpos - curpos %}
                    <td>
                        {{- curpos -}}
                        {{- badge -}}
                        {%- if posdiff > 0 %} <img title=" + {{ posdiff }} " src="/icons/famfamfam/bullet_green.png"/>
                        {%- elseif posdiff < 0 %} <img title=" {{ posdiff }} " src="/icons/famfamfam/bullet_red.png"/>
                        {%- endif -%}
                    </td>
                {% else %}
                    <td>{{ curpos }}{{ badge }}</td>
                {% endif %}

                <td class="hidden-xs hidden-sm">
                    <a href="{{ path('ploeg_show', {seizoen: seizoen.slug, id: ploeg[0].id}) }}#!ploeg">{{ ploeg[0].naam|u.truncate(75, '&#8230;')|raw }}</a>
                </td>
                <td class="hidden-sm hidden-xs">{{ ploeg[0].afkorting }}</td>
                <td class="hidden-lg hidden-md">
                    <a href="{{ path('ploeg_show', {seizoen: seizoen.slug, id: ploeg[0].id}) }}#!ploeg">{{ ploeg[0].afkorting }}</a>
                </td>
                {% if shadowlist %}
                    <td>{{ ploeg.punten }}</td>
                    {% if withPeriode is defined and withPeriode %}
                        <td>+{{ ploeg.punten - shadowlist[ploeg[0].id].punten }}</td>
                    {% endif %}
                {% else %}
                    <td>{{ ploeg.punten }}</td>
                {% endif %}
            </tr>
        {% endfor %}
    </table>
{% endblock %}
